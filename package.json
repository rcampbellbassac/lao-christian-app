{
  "name": "laochristian",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0 || ^26.0.0",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build:pages": "run-p type-check \"build-only {@}\" --",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "test:e2e:update": "playwright test --update-snapshots",
    "build-only": "vite build",
    "type-check": "run-p type-check:native type-check:vue",
    "type-check:native": "tsc --build tsconfig.node.json",
    "type-check:vue": "vue-tsc --build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/",
    "normalize:data": "node scripts/normalize-content.mjs",
    "normalize:data:check": "node scripts/normalize-content.mjs && node -e \"const fs=require('fs');const p='src/assets/data-normalized/normalization-report.json';console.log(fs.readFileSync(p,'utf8'))\"",
    "content:release": "node scripts/build-content-release.mjs",
    "content:publish": "bash scripts/publish-content.sh",
    "translate:static": "node scripts/translate-static-copy.mjs",
    "pages:build:project": "VITE_BASE_PATH='/lao-christian-app/' npm run build-only",
    "pages:build:root": "VITE_BASE_PATH='/' npm run build-only",
    "docker:up": "docker compose up -d --build",
    "docker:dev": "docker compose --profile dev up -d --build app-dev"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-lao": "^5.3.0",
    "@fontsource-variable/noto-sans-lao-looped": "^5.3.0",
    "@fontsource-variable/noto-serif-lao": "^5.3.0",
    "@fontsource/phetsarath": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "dompurify": "^3.4.14",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "localforage": "^1.10.0",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.1.7",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tsconfig/node26": "^26.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.0",
    "eslint-plugin-vue": "^10.10.0",
    "jiti": "^2.4.2",
    "jsdom": "^30.0.1",
    "minimatch": "^10.2.6",
    "npm-run-all2": "^9.0.3",
    "prettier": "3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "js-beautify": {
      "editorconfig": "^3.0.2"
    }
  }
}
